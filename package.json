{
  "name": "papers-write",
  "version": "0.2.0",
  "description": "Write papers in plain text: Markdown and LaTeX, cited from the papers library, built with texmark",
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test scripts/*.test.ts",
    "tauri": "tauri"
  },
  "exports": {
    "./editor": {
      "types": "./src/lib/editor/index.ts",
      "svelte": "./src/lib/editor/index.ts",
      "default": "./src/lib/editor/index.ts"
    },
    "./project": {
      "types": "./src/lib/project/index.ts",
      "svelte": "./src/lib/project/index.ts",
      "default": "./src/lib/project/index.ts"
    }
  },
  "files": [
    "src/lib/editor",
    "src/lib/project"
  ],
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "tauri-plugin-pdfkit-api": "github:mathesislab/tauri-plugin-pdfkit#v0.4.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
