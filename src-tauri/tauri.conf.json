{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papers Write",
  "version": "0.1.0",
  "identifier": "io.github.mathesislab.papers-write",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "txt",
          "tex",
          "bib",
          "yaml",
          "toml"
        ],
        "name": "Text document",
        "description": "A plain-text file",
        "role": "Editor"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "A PDF",
        "role": "Viewer"
      }
    ]
  }
}
