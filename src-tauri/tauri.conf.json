{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papers Write",
  "version": "0.6.2",
  "identifier": "io.github.mathesislab.papers-write",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "qmd",
          "txt",
          "tex",
          "bib",
          "yaml",
          "toml"
        ],
        "name": "Text document",
        "description": "A plain-text file",
        "role": "Editor"
      },
      {
        "ext": [
          "review"
        ],
        "name": "Papers Write review",
        "description": "A document with its review",
        "role": "Editor"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "A PDF",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4Nzc1RkYxREZFRTVGRTUKUldUbFgrN2Y4VjkzV0FGc2QwSGwyTEgyQTFRN3RMazBYRHd2VVpoSHpHL0R6bGRxN0NWVmRhVngK",
      "endpoints": [
        "https://github.com/mathesislab/papers-write/releases/latest/download/latest.json"
      ]
    }
  }
}
